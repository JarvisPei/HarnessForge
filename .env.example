# Copy this to .env and fill in your OpenAI-compatible relay endpoints.

WEAK_BASE_URL=https://your-relay.example.com/v1
WEAK_API_KEY=replace-me
WEAK_MODEL=gpt-5.4-mini
WEAK_PROVIDER=openai
# Default is chat (/chat/completions). Set to responses for OpenAI Responses API.
# WEAK_API_STYLE=responses

TEACHER_BASE_URL=https://your-relay.example.com/v1
TEACHER_API_KEY=replace-me
TEACHER_MODEL=gpt-5.5
TEACHER_PROVIDER=openai
# TEACHER_API_STYLE=responses
# Optional for OpenAI-compatible reasoning models. Leave unset if your relay/model
# rejects reasoning_effort. Keep weak unset by default for clean harness ablations.
TEACHER_REASONING_EFFORT=high

# Optional alternate profile. Run with: --profile <PROFILE_NAME>
WEAK_BASE_URL_CLAUDE=https://api.anthropic.com/v1
WEAK_API_KEY_CLAUDE=replace-me
WEAK_MODEL_CLAUDE=claude-haiku-4-5-20251001
# Most relays expose these models through chat-completions-style endpoints.
# Set to anthropic only for native Anthropic /messages endpoints.
WEAK_PROVIDER_CLAUDE=openai

TEACHER_BASE_URL_CLAUDE=https://api.anthropic.com/v1
TEACHER_API_KEY_CLAUDE=replace-me
TEACHER_MODEL_CLAUDE=claude-opus-4-7
TEACHER_PROVIDER_CLAUDE=openai
# TEACHER_REASONING_EFFORT_CLAUDE=high

# Optional shared settings.
REQUEST_TIMEOUT_SECONDS=600
REQUEST_MAX_RETRIES=2
REQUEST_RETRY_BACKOFF_SECONDS=2

# Optional tau-bench user-simulator shim. Use this if your relay accepts the
# raw HarnessForge ChatClient request but blocks LiteLLM requests.
# TAU_USER_BASE_URL=https://your-relay.example.com/v1
# TAU_USER_API_KEY=replace-me
# TAU_USER_API_STYLE=responses
# TAU_USER_TIMEOUT_SECONDS=600
